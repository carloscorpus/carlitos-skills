{
  "fields": {
    "name": { "type": "name", "required": true, "min": 3, "max": 100 },
    "phone": { "type": "phone", "required": true },
    "email": { "type": "email", "required": true },
    "dni": { "type": "digits", "required": true, "min": 8, "max": 8 },
    "message": { "type": "textarea", "required": true, "min": 10, "max": 500 },
    "company": { "type": "text" },
    "service": { "type": "select", "required": true, "options": { "a": "Opción A", "b": "Opción B" } },
    "contact": { "type": "radio", "required": true, "options": { "email": "Correo", "phone": "Teléfono" } },
    "newsletter": { "type": "checkbox" },
    "topics": { "type": "checkboxes", "required": true, "max": 2, "options": { "a": "Tema A", "b": "Tema B", "c": "Tema C" } },
    "extras": { "type": "checkboxes", "min": 2, "options": { "x": "Extra X", "y": "Extra Y", "z": "Extra Z" } },
    "consent": { "type": "consent" }
  },
  "cases": [
    { "field": "name", "value": "María José Muñoz-O'Brien", "expect": null },
    { "field": "name", "value": "  Ana Luz  ", "expect": null },
    { "field": "name", "value": " Ana ", "expect": null },
    { "field": "name", "value": "Zoë", "expect": null },
    { "field": "name", "value": "李小龍", "expect": null },
    { "field": "name", "value": "", "expect": "required" },
    { "field": "name", "value": "   ", "expect": "required" },
    { "field": "name", "value": "Ju", "expect": "min" },
    { "field": "name", "value": "Juan2", "expect": "invalid" },
    { "field": "name", "value": "Ana\tLuz", "expect": "invalid" },
    { "field": "name", "value": "Ana<b>", "expect": "invalid" },
    { "field": "name", "value": "Ana Luz", "expect": "invalid" },
    { "field": "name", "repeat": ["a", 101], "expect": "max" },

    { "field": "phone", "value": "+51 987 654 321", "expect": null },
    { "field": "phone", "value": "(01) 234-5678", "expect": null },
    { "field": "phone", "value": "- - - - - - -", "expect": "invalid" },
    { "field": "phone", "value": "123456", "expect": "invalid" },
    { "field": "phone", "value": "1234567890123456", "expect": "invalid" },
    { "field": "phone", "value": "987 654 321", "expect": "invalid" },
    { "field": "phone", "value": "+51 987 654 321 00 00", "expect": "max" },
    { "field": "phone", "value": "", "expect": "required" },

    { "field": "email", "value": "maria@empresa.pe", "expect": null },
    { "field": "email", "value": "maria+tag@empresa.com.pe", "expect": null },
    { "field": "email", "value": "a@b.co", "expect": null },
    { "field": "email", "value": "a@b.c", "expect": "invalid" },
    { "field": "email", "value": "x@", "expect": "invalid" },
    { "field": "email", "value": "maria@@x.pe", "expect": "invalid" },
    { "field": "email", "value": "maria@x..pe", "expect": "invalid" },
    { "field": "email", "value": "maria@-x.pe", "expect": "invalid" },
    { "field": "email", "value": "maria@x.pe.", "expect": "invalid" },
    { "field": "email", "value": "maría@x.pe", "expect": "invalid" },
    { "field": "email", "value": "maria@localhost", "expect": "invalid" },
    { "field": "email", "value": "<a>@x.pe", "expect": "invalid" },
    { "field": "email", "value": "maria@empresa_x.pe", "expect": "invalid" },
    { "field": "email", "value": "", "expect": "required" },

    { "field": "dni", "value": "12345678", "expect": null },
    { "field": "dni", "value": "1234567", "expect": "min" },
    { "field": "dni", "value": "123456789", "expect": "max" },
    { "field": "dni", "value": "1234567a", "expect": "invalid" },
    { "field": "dni", "value": "１２３４５６７８", "expect": "invalid" },

    { "field": "message", "value": "Hola, mi correo es a@b.pe y \"Norte\" #2 \\ fin", "expect": null },
    { "field": "message", "value": "línea uno\nlínea dos", "expect": null },
    { "field": "message", "value": "😀😀😀😀😀😀😀😀😀😀", "expect": null },
    { "field": "message", "value": "hola", "expect": "min" },
    { "field": "message", "value": "<script>alert(1)</script> texto", "expect": "invalid" },
    { "field": "message", "value": "\u0007 hola hola hola", "expect": "invalid" },
    { "field": "message", "repeat": ["a", 501], "expect": "max" },

    { "field": "company", "value": "", "expect": null },
    { "field": "company", "value": "Empresa S.A.C.", "expect": null },
    { "field": "company", "value": "a<b", "expect": "invalid" },
    { "field": "company", "value": "línea\notra", "expect": "invalid" },

    { "field": "service", "value": "a", "expect": null },
    { "field": "service", "value": "c", "expect": "invalid" },
    { "field": "service", "value": "", "expect": "required" },

    { "field": "contact", "value": "email", "expect": null },
    { "field": "contact", "value": "fax", "expect": "invalid" },
    { "field": "contact", "value": "", "expect": "required" },

    { "field": "newsletter", "value": false, "expect": null },
    { "field": "newsletter", "value": true, "expect": null },
    { "field": "consent", "value": false, "expect": "required" },
    { "field": "consent", "value": true, "expect": null },

    { "field": "topics", "value": ["a"], "expect": null },
    { "field": "topics", "value": ["b", "a"], "expect": null },
    { "field": "topics", "value": ["a", "a", "b"], "expect": null },
    { "field": "topics", "value": [], "expect": "required" },
    { "field": "topics", "value": ["a", "d"], "expect": "invalid" },
    { "field": "topics", "value": ["a", "b", "c"], "expect": "max" },

    { "field": "extras", "value": [], "expect": null },
    { "field": "extras", "value": ["x", "z"], "expect": null },
    { "field": "extras", "value": ["x"], "expect": "min" },
    { "field": "extras", "value": ["x", "x"], "expect": "min" },
    { "field": "extras", "value": ["w", "x"], "expect": "invalid" }
  ]
}
