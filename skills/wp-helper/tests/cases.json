  "groups": [
    {
      "name": "dos estilos",
      "styles": [
        {
          "name": "naranja",
          "marker": "|",
          "class": "text-anaranjado"
        },
        {
          "name": "rojo",
          "marker": "*",
          "class": "text-rojo"
        }
      ],
      "text": [
        {
          "name": "un estilo",
          "input": "Hola |mundo|",
          "expect": "Hola <span class=\"text-anaranjado\">mundo</span>"
        },
        {
          "name": "dos estilos en el mismo texto",
          "input": "Negro |naranja| y *rojo*",
          "expect": "Negro <span class=\"text-anaranjado\">naranja</span> y <span class=\"text-rojo\">rojo</span>"
        },
        {
          "name": "solo uno de los estilos",
          "input": "Negro |naranja| y *rojo*",
          "only": "rojo",
          "expect": "Negro |naranja| y <span class=\"text-rojo\">rojo</span>"
        },
        {
          "name": "estilo inexistente no marca nada",
          "input": "Hola |mundo|",
          "only": "zzz",
          "expect": "Hola |mundo|"
        },
        {
          "name": "varios tramos del mismo estilo",
          "input": "|a| y |b|",
          "expect": "<span class=\"text-anaranjado\">a</span> y <span class=\"text-anaranjado\">b</span>"
        },
        {
          "name": "& se escapa una sola vez",
          "input": "a & b |c & d|",
          "expect": "a &amp; b <span class=\"text-anaranjado\">c &amp; d</span>"
        },
        {
          "name": "HTML del texto se escapa",
          "input": "<b>x</b> |y|",
          "expect": "&lt;b&gt;x&lt;/b&gt; <span class=\"text-anaranjado\">y</span>"
        },
        {
          "name": "comillas se escapan",
          "input": "dijo \"hola\" |ya|",
          "expect": "dijo &quot;hola&quot; <span class=\"text-anaranjado\">ya</span>"
        },
        {
          "name": "caracteres con tilde",
          "input": "|ñandú|",
          "expect": "<span class=\"text-anaranjado\">ñandú</span>"
        },
        {
          "name": "marcador sin cerrar",
          "input": "Hola |mundo",
          "expect": "Hola |mundo"
        },
        {
          "name": "espacios en el borde no marcan",
          "input": "| espacio |",
          "expect": "| espacio |"
        },
        {
          "name": "marcador pegado a letras no marca",
          "input": "a|b|c",
          "expect": "a|b|c"
        },
        {
          "name": "cierre pegado a letra no marca",
          "input": "|a|b",
          "expect": "|a|b"
        },
        {
          "name": "marcadores vacíos",
          "input": "||",
          "expect": "||"
        },
        {
          "name": "salto de línea del textarea",
          "input": "Hola\nmundo",
          "expect": "Hola<br />\nmundo"
        },
        {
          "name": "salto con color en la segunda línea",
          "input": "Terminal Portuario\ndel |Callao|",
          "expect": "Terminal Portuario<br />\ndel <span class=\"text-anaranjado\">Callao</span>"
        },
        {
          "name": "salto de Windows (CRLF) cuenta como uno",
          "input": "a\r\nb",
          "expect": "a<br />\nb"
        },
        {
          "name": "un marcador no cruza de línea",
          "input": "|a\nb|",
          "expect": "|a<br />\nb|"
        },
        {
          "name": "null",
          "input": null,
          "expect": ""
        },
        {
          "name": "string vacío",
          "input": "",
          "expect": ""
        }
      ]
    },
    {
      "name": "los cinco marcadores a la vez (clases con - y _)",
      "styles": [
        {
          "name": "a",
          "marker": "*",
          "class": "text-a-b_c-1"
        },
        {
          "name": "b",
          "marker": "|",
          "class": "text-a-b_c-1"
        },
        {
          "name": "c",
          "marker": "~",
          "class": "text-a-b_c-1"
        },
        {
          "name": "d",
          "marker": "^",
          "class": "text-a-b_c-1"
        },
        {
          "name": "e",
          "marker": "=",
          "class": "text-a-b_c-1"
        }
      ],
      "text": [
        {
          "name": "cada marcador marca una sola vez",
          "input": "*a* |b| ~c~ ^d^ =e=",
          "expect": "<span class=\"text-a-b_c-1\">a</span> <span class=\"text-a-b_c-1\">b</span> <span class=\"text-a-b_c-1\">c</span> <span class=\"text-a-b_c-1\">d</span> <span class=\"text-a-b_c-1\">e</span>"
        },
        {
          "name": "guion, teléfono y snake_case intactos",
          "input": "pre-fijo 555-123-4567 snake_case a=b=c",
          "expect": "pre-fijo 555-123-4567 snake_case a=b=c"
        },
        {
          "name": "guion y guion bajo no son marcadores",
          "input": "-oferta- y _nuevo_",
          "expect": "-oferta- y _nuevo_"
        }
      ]
    }
  ],
